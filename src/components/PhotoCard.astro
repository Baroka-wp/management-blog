---
export interface Props {
  title: string;
  image: string;
  href: string;
}

const { title, image, href } = Astro.props;
---

<a href={href} class="card">
  <img src={image} alt={title} />
  <div class="title-overlay">
    <h3>{title}</h3>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .title-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 1rem;
    text-align: center;
  }

  .title-overlay h3 {
    margin: 0;
    font-size: 1.2rem;
  }
</style>
